<UserControl x:Class="Simulator.Siloz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Simulator"
             Height="600" Width="800">
    <UserControl.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>

        <!-- Panou comenzi stanga -->
        <StackPanel>
            <ToggleButton Content="Nivel 1" Width="100" Margin="5"
              IsChecked="{Binding IsNivel1Selected, Mode=OneWay}"
              Command="{Binding SetLevelCommand}" CommandParameter="0"/>
            <ToggleButton Content="Nivel 2" Width="100" Margin="5"
              IsChecked="{Binding IsNivel2Selected, Mode=OneWay}"
              Command="{Binding SetLevelCommand}" CommandParameter="1"/>
            <ToggleButton Content="Nivel 3" Width="100" Margin="5"
              IsChecked="{Binding IsNivel3Selected, Mode=OneWay}"
              Command="{Binding SetLevelCommand}" CommandParameter="2"/>
            <ToggleButton Content="Nivel 4" Width="100" Margin="5"
              IsChecked="{Binding IsNivel4Selected, Mode=OneWay}"
              Command="{Binding SetLevelCommand}" CommandParameter="3"/>

            <!-- Luminitele de stare -->
            <StackPanel Margin="10,20,0,0">
                <Ellipse Width="20" Height="20" Stroke="Black" StrokeThickness="1"
                         Fill="{Binding IsNivel1Reached, Converter={StaticResource BoolToColorConverter}}" />
                <Ellipse Width="20" Height="20" Stroke="Black" StrokeThickness="1"
                         Fill="{Binding IsNivel2Reached, Converter={StaticResource BoolToColorConverter}}" />
                <Ellipse Width="20" Height="20" Stroke="Black" StrokeThickness="1"
                         Fill="{Binding IsNivel3Reached, Converter={StaticResource BoolToColorConverter}}" />
                <Ellipse Width="20" Height="20" Stroke="Black" StrokeThickness="1"
                         Fill="{Binding IsNivel4Reached, Converter={StaticResource BoolToColorConverter}}" />
            </StackPanel>
        </StackPanel>

        <!-- Siloz vizual centru -->
        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="3" CornerRadius="20" Height="500" Width="200" VerticalAlignment="Center">
            <Grid>
                <Border Background="LightBlue" VerticalAlignment="Bottom" Height="{Binding CurrentLevel}" CornerRadius="0,0,20,20"/>
                <Canvas Width="200" Height="500">
                    <Line X1="0" X2="195" Y1="395" Y2="395" Stroke="Red" StrokeThickness="2"/>
                    <Line X1="0" X2="195" Y1="295" Y2="295" Stroke="Red" StrokeThickness="2"/>
                    <Line X1="0" X2="195" Y1="195" Y2="195" Stroke="Red" StrokeThickness="2"/>
                    <Line X1="0" X2="195" Y1="95" Y2="95" Stroke="Red" StrokeThickness="2"/>

                    <TextBlock Text="Nivel 4" FontWeight="Bold" Margin="-50,87,0,0"/>
                    <TextBlock Text="Nivel 3" FontWeight="Bold" Margin="-50,187,0,0"/>
                    <TextBlock Text="Nivel 2" FontWeight="Bold" Margin="-50,287,0,0"/>
                    <TextBlock Text="Nivel 1" FontWeight="Bold" Margin="-50,387,0,0"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Panou comenzi dreapta -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <TextBlock Text="Comenzi valva/supapa" FontWeight="Bold" Margin="0,0,0,10" />
            <RepeatButton    Delay="50" Content="Deschide Valva Iesire" Width="150" Margin="0,5" Command="{Binding DescarcareCommand}" />
            <RepeatButton  Delay="50" Content="Deschide Supapa Alimentare" Width="150" Margin="0,5" Command="{Binding IncarcareCommand}" />

            <TextBlock Text="Debit Intrare" FontWeight="Bold" Margin="0,20,0,0" />
            <Slider Minimum="0" Maximum="100" Value="{Binding LoadSpeed}" Width="150" />

            <TextBlock Text="Debit Iesire" FontWeight="Bold" Margin="0,20,0,0" />
            <Slider Minimum="0" Maximum="100" Value="{Binding DischargeSpeed}" Width="150" />
            <CheckBox Content="Mod Automat" IsChecked="{Binding IsAutomaticMode}" Width="150" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

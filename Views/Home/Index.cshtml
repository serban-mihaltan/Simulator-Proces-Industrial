@model List<MonitorApi.Models.LogRecord>
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Monitor Logs</title>
    <style>
        table { border-collapse: collapse; width: 100%; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        th { background: #f4f4f4; }
    </style>
</head>
<body>
    <h1>Monitor Logs</h1>
    <table>
        <tr><th>Id</th><th>State</th><th>Timestamp</th></tr>
        @foreach(var record in Model)
        {
            <tr>
                <td>@record.Id</td>
                <td>@record.State</td>
                <td>@record.Timestamp.ToString("u")</td>
            </tr>
        }
    </table>
</body>
</html>